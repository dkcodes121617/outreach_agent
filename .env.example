# GENERATED by tools/make_env_example.py from this folder's .env.
# Do not hand-edit: edit .env, then regenerate. Secret values are blanked.
# Copy to .env and fill in every empty value.
# ═══════════════════════════════════════════════════════════════════════════
# Outreach Agent — environment  (REAL VALUES · SELF-CONTAINED)
# ═══════════════════════════════════════════════════════════════════════════
# Complete on its own: this agent deploys independently and reads nothing from
# outside its own folder.
#
# Production mirror: the Modal secret `wizcodes-outreach` (see deploy.ps1).
# Run `python shared/check_env.py` after any rotation — it fails on drift.
#
# This agent is a pure CONSUMER of core.leads. It discovers nothing and writes
# no lead of its own — that is the Lead Finder's job, and keeping one writer is
# what makes "no duplicates, nothing missed" a property of the schema rather
# than a promise in a document.
# ═══════════════════════════════════════════════════════════════════════════

# ── Claude-compatible proxy (ClaudeStore) ──
ANTHROPIC_BASE_URL=https://api3.claudestore.store
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4.6
ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4.5
ANTHROPIC_STRATEGY_MODEL=claude-opus-4-8

# ── Neon Postgres (Postgres 18) ──
# Owns `outreach.*`; checkpoints into `oa_ckpt`.
NEON_DATABASE_URL=
LANGGRAPH_CHECKPOINT_SCHEMA=oa_ckpt

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TOPIC_OUTREACH=
TELEGRAM_TOPIC_ALERTS=
TELEGRAM_CALLBACK_PREFIX=oa

# ── Site repo (grounding facts, READ-ONLY) ──
# Every draft cites a REAL WizCodes project with a REAL URL. That list comes
# from the repo, never from the model's memory.
# TODO — CREATE. Fine-grained PAT, Contents: READ ONLY, this repo only.
SITE_REPO=dkcodes121617/wizcodes_main_website
SITE_REPO_BRANCH=main
SITE_READ_TOKEN=

# ── Cloudflare R2 (key prefix: screenshots/) ──
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ENDPOINT=
R2_BUCKET_NAME=wizcodes-ai-images
R2_KEY_PREFIX=
R2_PUBLIC_BASE_URL=https://pub-058bcb53a480447eaefd881835c363d8.r2.dev

# ── Groq (free tier) ──
# TODO — CREATE at console.groq.com. Runs the vision pass over the PageSpeed
# screenshot. Free-tier limits are per ACCOUNT — shared budget with the Lead
# Finder whether or not the key is shared.
GROQ_API_KEY=

# ── Behaviour ──
LOG_LEVEL=INFO
DRY_RUN=1
DISPLAY_TZ=Asia/Kolkata

# ═══════════════════════════════════════════════════════════════════════════
# Agent-specific
# ═══════════════════════════════════════════════════════════════════════════

# ── Channels ──
# email    : agent drafts -> you approve -> agent sends
# linkedin : agent drafts -> you approve -> YOU send from your own session
# whatsapp : same as linkedin, and second-touch by default
# Starts with the two zero-risk channels; add `email` after a supervised run.
CHANNELS_ENABLED=linkedin,whatsapp

# ── Cold email (Brevo) ──
BREVO_API_KEY=
# TODO — SET UP THE SENDING SUBDOMAIN. A dedicated subdomain, not the address
# that receives client mail: a cold campaign's deliverability problems must not
# reach the inbox your invoices arrive in. Add SPF, DKIM and DMARC for
# mail.wizcodes.site in the SAME Cloudflare DNS zone the site already uses,
# then verify the sender in Brevo.
OUTREACH_FROM_EMAIL=hello@wizcodes.site
OUTREACH_FROM_NAME=Divya at WizCodes
OUTREACH_REPLY_TO=hello@wizcodes.site
# TODO — REQUIRED BEFORE THE FIRST SEND. CAN-SPAM requires a real postal
# address in every commercial email. Not optional, not a later addition.
OUTREACH_POSTAL_ADDRESS=WizCodes, Ahmedabad, Gujarat 382443, India
# One click, no login, no "reply to unsubscribe".
# NOTE: this CANNOT be a wizcodes.site path — the site is output:'export' on
# Firebase Hosting, static files with no server to run a handler. It is a
# Cloudflare Worker route, same as the contact form and Wico already are.
# TODO — fill in after `wrangler deploy` of the wizcodes-inbound worker.
UNSUBSCRIBE_BASE_URL=https://wizcodes-inbound.wizcodes12.workers.dev/u/

# ── Send limits ──
# Brevo's free tier allows 300/day. Sending near a ceiling is how a new domain
# gets classified as a blaster: ramp slowly, stay well under.
MAX_EMAILS_PER_DAY=20
MAX_EMAILS_PER_RUN=10
SEND_JITTER_SECONDS=180
# One follow-up. A sequence of five is what makes cold email feel like spam to
# the person receiving it.
FOLLOWUP_AFTER_DAYS=6
MAX_SEQUENCE_STEPS=2

# ── Website assessment ──
# TODO — CREATE. Genuinely free, 25,000 queries/day, no card for this API
# specifically. Same Google Cloud project as the Places key: enable "PageSpeed
# Insights API" and create a second restricted key.
# Returns the performance score, the mobile audit AND a full-page screenshot in
# one call — which is why this agent needs no browser at all.
GOOGLE_PAGESPEED_API_KEY=
PAGESPEED_STRATEGY=mobile
# Below this there is nothing specific to say, and a pitch with nothing
# specific to say is the one that gets deleted.
MIN_WEAKNESS_SCORE=45
ASSESSMENT_TTL_DAYS=45
VISION_MODEL=
VISION_ONLY_WHEN_AMBIGUOUS=1

# ── Enrichment ──
TAVILY_API_KEY=
REQUIRE_MX_CHECK=1
EMAIL_PATTERNS=info,contact,hello,enquiries,admin

# ── Approval ──
APPROVAL_TIMEOUT_HOURS=72
# A draft older than this is stale: the assessment it cites may no longer be
# true. Back to the queue for a fresh draft rather than sent as written.
REDRAFT_IF_STALE_HOURS=96

# ── Compliance ──
# Never contact the same business twice inside this window, however many times
# it resurfaces across sources. Enforced in core.claim_leads(); mirrored here
# so the value is visible where it is operated.
RETOUCH_COOLDOWN_DAYS=90
PII_RETENTION_DAYS=180
APPROVAL_MODE=notify_only
EMAIL_PROVIDER=brevo
RAMP_TARGET_PER_DAY=250
RAMP_START_DATE=
SENDING_DOMAINS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
MAX_BOUNCE_RATE=0.03
MAX_COMPLAINT_RATE=0.001
ANTHROPIC_VOICE_MODEL=claude-opus-4-8
UNSUBSCRIBE_SECRET=
LLM_PROVIDER=proxy
